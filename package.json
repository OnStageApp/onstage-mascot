{
  "name": "@onstageapp/mascot",
  "version": "0.5.0",
  "description": "The OnStage mascot: spec data, baker and the web player.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./packages/web/dist/index.d.ts",
      "import": "./packages/web/dist/index.js"
    },
    "./react": {
      "types": "./packages/web/dist/react.d.ts",
      "import": "./packages/web/dist/react.js"
    },
    "./static": {
      "types": "./packages/web/dist/static.d.ts",
      "import": "./packages/web/dist/static.js"
    },
    "./static-svg": {
      "types": "./packages/web/dist/static-svg.d.ts",
      "import": "./packages/web/dist/static-svg.js"
    },
    "./spec/*": "./spec/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "packages/web/dist",
    "spec",
    "assets"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "bake": "node tools/bake.mjs",
    "build": "node tools/gen-web-data.mjs && tsc -p packages/web/tsconfig.json",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "typecheck:consumer": "tsc -p tests/consumer/tsconfig.json",
    "render-svg": "node tools/render-svg.mjs",
    "render-png": "node tools/render-png.mjs",
    "contact-sheet": "node tools/contact-sheet.mjs",
    "parity:web": "node tests/parity/render-web-frames.mjs",
    "parity:web:static": "node tests/parity/render-web-static.mjs",
    "export-static": "node tools/export-static.mjs",
    "preview": "node tools/serve.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnStageApp/onstage-mascot.git"
  }
}
